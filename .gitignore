# ---- never commit ----

# Backups of a previous .git directory (git init'ing a fresh repo renames the
# old one aside; it must never become part of the new history).
.git_old*/
*.git_backup*

# pixi's environment: ~1.6 GB, regenerated by `pixi install`.
.pixi/

# Downloaded/cached market data: ~230 MB of parquet + json.
# Regenerated by `pixi run refresh_market_index_list` + `pixi run update-data`.
data/

# python bytecode
__pycache__/
*.pyc

# local secrets
.streamlit/secrets.toml
